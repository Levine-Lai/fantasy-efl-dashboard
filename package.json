    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
